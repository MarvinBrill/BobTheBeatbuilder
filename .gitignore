# All local application data and downloaded dependencies stay out of Git.
# Includes songs, datasets, models, generated maps, SQLite, caches and tools.
/data/

# Local configuration and credentials. Keep the setup template versioned.
.env
.env.*
!.env.example

# Python environments, bytecode and tool caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# Local logs and editor / operating system files.
*.log
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

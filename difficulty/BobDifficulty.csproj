<Project Sdk="Microsoft.NET.Sdk">
  <!-- Official osu! difficulty calculation (the same code lazer uses) for training labels and
       generated maps. Bump the package version to follow future star rating reworks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ppy.osu.Game.Rulesets.Osu" Version="2026.1026.0" />
  </ItemGroup>
</Project>
